<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FM26 Scout Mod — BepInEx 6 (IL2CPP) plugin.

    FM26 runs on Unity 6 + IL2CPP, so this targets BepInEx 6 IL2CPP.
    Build on your PC with:  dotnet build -c Release
    Output:                 bin/Release/net6.0/FM26ScoutMod.dll  → copy to <game>/BepInEx/plugins/
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>FM26ScoutMod</AssemblyName>
    <Product>FM26 Scout Mod</Product>
    <Version>0.10.0</Version>
    <LangVersion>latest</LangVersion>
    <!-- Nullable reference types clash with the IL2CPP interop assemblies (CS0656), so keep off. -->
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- BepInEx packages live on the BepInEx NuGet feed, not just nuget.org -->
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>

    <!--
      Path to your FM26 install. If your game lives somewhere else, change this ONE line.
      The interop assemblies BepInEx generates live under <GameDir>\BepInEx\interop.
    -->
    <GameDir>D:\SteamLibrary\steamapps\common\Football Manager 26</GameDir>
    <InteropDir>$(GameDir)\BepInEx\interop</InteropDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core BepInEx 6 IL2CPP runtime (provides BasePlugin + Il2CppInterop.Runtime). -->
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
  </ItemGroup>

  <!--
    Game / Unity interop assemblies, referenced from your local BepInEx\interop folder.
    Compile-time only (Private=false) — BepInEx already loads these at runtime, so we
    must NOT copy them into our output.
  -->
  <ItemGroup>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(InteropDir)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(InteropDir)\Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(InteropDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(InteropDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- FM26 game assemblies for the data model (Stage 2). -->
    <Reference Include="FM.UI">
      <HintPath>$(InteropDir)\FM.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SI.Interop">
      <HintPath>$(InteropDir)\SI.Interop.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SI.Bindable.Reference.Core">
      <HintPath>$(InteropDir)\SI.Bindable.Reference.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Auto-deploy: after every successful build, copy our DLL straight into the
    game's BepInEx\plugins folder. No more manual Copy-Item.
    (Close FM26 before building — a running game locks the DLL. ContinueOnError
    keeps the build green if it's locked; just close the game and rebuild.)
  -->
  <Target Name="DeployToGame" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(GameDir)\BepInEx\plugins"
          ContinueOnError="true" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> $(GameDir)\BepInEx\plugins" />
  </Target>

</Project>
